# Apify token for the eBay sold-listings actor (caffein.dev/ebay-sold-listings).
# Server-side only — never prefix with NEXT_PUBLIC_.
# Copy this file to .env.local and fill in the value; .env.local is gitignored.
# Without it, the card page still works; the eBay section shows a
# "not configured" notice instead.
APIFY_API_TOKEN=

# Anthropic key for the semantic fallback classifier (LangChain).
# Server-side only. Without it, classification stays purely deterministic.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5-20251001.
LLM_MODEL=

# Semantic fallback is OFF unless this is exactly "true". Keep it off until the
# model has been evaluated — see scripts/eval-semantic.cjs.
ENABLE_LLM_FALLBACK=false
